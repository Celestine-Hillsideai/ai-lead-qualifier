# OpenAI API key used by qualify-lead to call the model.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the default model (gpt-5.6-terra).
# OPENAI_MODEL=gpt-5.6-sol

# trigger.dev CLI reads this automatically when you run `npx trigger.dev login`
# and `npx trigger.dev dev` / `deploy` — you generally don't need to set it by
# hand, but it's listed here for reference.
# TRIGGER_SECRET_KEY=
